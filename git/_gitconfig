[user]
  email = beetle-noise@gmx.com
  name = IzumiSy
[core]
  editor = vim
  excludesfile = ~/.gitignore_global
  ignorecase = false
  pager = delta
[delta]
  side-by-side = true
  line-numbers = true
  navigate = true
[merge]
  tool = vimdiff2
  conflictstyle = zdiff3
[push]
  default = tracking
[diff]
  tool = vimdiff2
  algorithm = histogram
  colorMoved = default
[difftool]
  prompt = false
[color]
  ui = true
  diff = auto
  status = auto
  branch = auto
[rerere]
  enabled = 1
  autoupdate = true
[rebase]
  autosquash = true
  autostash = true
[pull]
  rebase = true
[mergetool]
  keepBackup = false
[interactive]
  diffFilter = delta --color-only
[sequence]
  editor = vim
