[user]
  email = beetle-noise@gmx.com
  name = IzumiSy
[core]
  editor = vim
  excludesfile = ~/.gitignore_global
  ignorecase = false
  pager = delta
[merge]
  tool = vimdiff2
  conflictstyle = zdiff3
[push]
  default = tracking
[diff]
  tool = vimdiff2
  algorithm = histogram
  colorMoved = default
[difftool]
  prompt = false
[color]
  ui = true
  diff = auto
  status = auto
  branch = auto
[rerere]
  enabled = 1
  autoupdate = true
[rebase]
  autosquash = true
  autostash = true
[pull]
  rebase = true
[mergetool]
  keepBackup = false
[interactive]
  diffFilter = delta --color-only
[sequence]
  editor = vim

[delta]
  features = chameleon
  side-by-side = true
  line-numbers = true
  navigate = true
[delta "chameleon"]
  #author: https://github.com/AirOnSkin
  dark = true
  line-numbers = true
  side-by-side = true
  keep-plus-minus-markers = true
  syntax-theme = Nord
  file-style = "#434C5E" bold
  file-decoration-style = "#434C5E" ul
  file-added-label = [+]
  file-copied-label = [==]
  file-modified-label = [*]
  file-removed-label = [-]
  file-renamed-label = [->]
  hunk-header-style = omit
  line-numbers-left-format = " {nm:>1} │"
  line-numbers-left-style = red
  line-numbers-right-format = " {np:>1} │"
  line-numbers-right-style = green
  line-numbers-minus-style = red italic black
  line-numbers-plus-style = green italic black
  line-numbers-zero-style = "#434C5E" italic
  minus-style = bold red
  minus-emph-style = bold red
  plus-style = bold green
  plus-emph-style = bold green
  zero-style = syntax
  blame-code-style = syntax
  blame-format = "{author:<18} ({commit:>7}) {timestamp:^12} "
