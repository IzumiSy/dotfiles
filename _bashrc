# A predicate function to determine if the given command exists or not
function exists() {
  type "$1" &> /dev/null ;
}

_dotfiles_bash_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/bash"
source "$_dotfiles_bash_dir/base.sh"

# Homebrew must be initialized before tool-dependent aliases.
if exists /opt/homebrew/bin/brew ; then
  eval $(/opt/homebrew/bin/brew shellenv)
fi
source "$_dotfiles_bash_dir/commands.sh"
source "$_dotfiles_bash_dir/sandbox.sh"
source "$_dotfiles_bash_dir/tools.sh"
unset _dotfiles_bash_dir
